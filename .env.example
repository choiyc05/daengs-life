# 레포 루트 .env — compose 가 읽는 **인프라** 값만 둔다 (D-014).
# 백엔드가 쓰는 API 키는 backend/.env.example 참고.
#
# 변수마다 집은 하나다. DB 접속정보는 여기에만 두고, 백엔드에는 compose 가 조립해 내려준다:
#   backend:
#     environment:
#       DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
