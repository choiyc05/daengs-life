# env
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/

# misc
.DS_Store

# data — 원본/가공물은 커밋하지 않는다 (D-008). 출처 메타와 시드 목록만 추적.
# 'data/raw/' 로 쓰면 git이 폴더 안으로 안 들어가서 아래 예외가 안 먹으므로 '*/*' 사용
data/raw/*/*
!data/raw/*/*.meta.json
!data/raw/*/.gitkeep
data/processed/*/*
!data/processed/*/.gitkeep
data/manifests/crawl_log.jsonl
