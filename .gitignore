# env
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/

# misc
.DS_Store

# data — 수집·가공 산출물은 전부 로컬이다 (RAG-008 → RAG-017 로 확대).
# 추적하는 것은 '무엇을 받을지'(seed_sources.yaml)와 폴더 구조(.gitkeep) 뿐이고,
# 받은 결과물(원본·meta·크롤 로그·가공물)은 어느 것도 커밋하지 않는다.
# 'data/raw/' 로 쓰면 git이 폴더 안으로 안 들어가서 아래 예외가 안 먹으므로 '*/*' 사용
data/raw/*/*
!data/raw/*/.gitkeep
data/processed/*/*
!data/processed/*/.gitkeep
# 예외 — 랩 답변 덤프는 추적한다 (RAG-017 '예외' 절).
# LLM 출력이라 다시 돌려도 같은 글이 안 나오는데 RAG-028 ⑥ 이 랩 비교 축으로 지정했다. 한 랩에 16KB.
!data/processed/answers/*.jsonl
data/manifests/crawl_log.jsonl
