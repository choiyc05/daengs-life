# backend/.env — 이 배포 단위(FastAPI · Celery worker · beat · crawler CLI)가 쓰는 값 (D-014).
# 넷은 같은 이미지에서 도는 같은 코드라 env 도 하나를 공유한다.
#
# 읽는 순서: 실제 환경변수 > backend/.env > 레포 루트 .env
#   배포에서는 오케스트레이터가 넣은 환경변수가 항상 이기므로 이 파일은 로컬 개발용이다.
#   값은 커밋되지 않는다 (.gitignore 의 `.env` 패턴이 하위 경로까지 잡는다).

# --- 크롤러 API 키 — 발급처와 용도는 docs/data-sources.md §9 ---
# URL 쿼리스트링에 들어가지만 저장·로그·출력 전에 *** 로 가려진다 (config.redact, D-012)
LAW_OC=
DATA_GO_KR_KEY=
KAKAO_REST_KEY=
SEOUL_OPEN_DATA_KEY=
KMA_HUB_KEY=

# --- LLM (예정) ---
GEMINI_API_KEY=

# --- 경로 override ---
# 레포 안에서 실행하면 data/ 를 알아서 찾으므로 비워 둔다.
# 컨테이너처럼 레포 밖에서 돌릴 때만 지정한다 (예: /data + 볼륨 마운트).
# DAENGS_DATA_DIR=
